rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Genel yönetici: yalnız Tolga (Hit Pazarı paneli). Halalar bir mağazadır, panel yetkisi yok (Tolga 15.11).
    function yonetici() {
      return request.auth != null && request.auth.token.email == 'tolgaarpa@gmail.com' && request.auth.token.email_verified == true;
    }
    // Teklif ve satın alma talepleri (ad + telefon içerir): okuma yalnız yönetici
    match /talepler/{id} {
      allow create: if request.resource.data.keys().hasOnly(['urun','urunAd','tur','tutar','ad','tel','durum','zaman','satici','liste'])
                    && (!('liste' in request.resource.data) || (request.resource.data.liste is string && request.resource.data.liste.size() <= 1500))
                    && request.resource.data.keys().hasAll(['urun','urunAd','tur','tutar','ad','tel','durum','zaman','satici'])
                    && request.resource.data.urun is string && request.resource.data.urun.size() > 0 && request.resource.data.urun.size() <= 120
                    && request.resource.data.urunAd is string && request.resource.data.urunAd.size() > 0 && request.resource.data.urunAd.size() <= 120
                    && request.resource.data.satici in ['halalar','dukkan2','dukkan3']
                    && request.resource.data.tur in ['teklif','alim']
                    && request.resource.data.tutar is int && request.resource.data.tutar > 0 && request.resource.data.tutar < 10000000
                    && request.resource.data.ad is string && request.resource.data.ad.size() > 1 && request.resource.data.ad.size() < 60
                    && request.resource.data.tel is string && request.resource.data.tel.matches('^[+]?[0-9]{10,15}$')
                    && request.resource.data.durum == 'Beklemede'
                    && request.resource.data.zaman == request.time;
      allow read, update, delete: if yonetici();
    }
    // Görüş bildir (test dönemi): herkes yazar, yalnız yönetici okur/siler
    match /gorusler/{id} {
      allow create: if request.resource.data.keys().hasOnly(['metin','iletisim','sayfa','ekran','zaman'])
                    && request.resource.data.keys().hasAll(['metin','iletisim','sayfa','ekran','zaman'])
                    && request.resource.data.metin is string && request.resource.data.metin.size() >= 2 && request.resource.data.metin.size() <= 1000
                    && request.resource.data.iletisim is string && request.resource.data.iletisim.size() <= 80
                    && request.resource.data.sayfa is string && request.resource.data.sayfa.size() <= 200
                    && request.resource.data.ekran is string && request.resource.data.ekran.size() <= 20
                    && request.resource.data.zaman == request.time;
      allow read, delete: if yonetici();
    }
    // Müşterinin gördüğü durum (kişisel bilgi yok): belge no ile okunur, yalnız yönetici yazar
    match /durumlar/{id} {
      allow get: if true;
      allow list, write: if yonetici();
    }
    // Üye hesabı: kişi yalnız kendi belgesini okur/yazar (beğeniler, teklif listesi, iletişim bilgisi)
    match /uyeler/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['begeni','islem','kisi','guncel'])
                    && request.resource.data.begeni is list && request.resource.data.begeni.size() <= 500
                    && request.resource.data.islem is list && request.resource.data.islem.size() <= 200
                    && request.resource.data.kisi is map
                    && request.resource.data.guncel == request.time;
    }
  }
}
